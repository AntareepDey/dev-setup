[blur-my-shell]
hacks-level=1
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.69999999999999996>, 'unscaled_radius': <41>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>, 'unscaled_radius': <39>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <20>, 'corners_top': <true>}>}>]>}}
rounded-blur-found=false
settings-version=2

[blur-my-shell/appfolder]
brightness=0.40999999999999998
sigma=39

[blur-my-shell/applications]
blur=false
opacity=180
pipeline='pipeline_default'
sigma=38

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
override-background=true
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0
unblur-in-overview=true

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'
style-components=2

[blur-my-shell/panel]
brightness=0.59999999999999998
pipeline='pipeline_default'
sigma=30
static-blur=true

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[caffeine]
cli-toggle=false
duration-timer=3
duration-timer-list=[1200, 2400, 4500]
enable-fullscreen=false
indicator-position-max=1
show-timer=true
toggle-shortcut=['']
user-enabled=false

[clipboard-indicator]
blink-icon-on-copy=false
cache-size=20
clear-on-boot=false
disable-down-arrow=true
display-mode=0
history-size=40
move-item-first=true
next-history-clear=-1
paste-on-select=true
preview-size=28

[dash-to-dock]
apply-custom-theme=false
autohide=true
background-opacity=0.80000000000000004
click-action='minimize-or-previews'
custom-theme-shrink=false
dash-max-icon-size=32
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
height-fraction=0.90000000000000002
hide-delay=0.10000000000000002
hide-tooltip=false
icon-size-fixed=false
intellihide=false
intellihide-mode='ALL_WINDOWS'
middle-click-action='launch'
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
pressure-threshold=50.0
preview-size-scale=0.0
running-indicator-style='DOT'
scroll-action='cycle-windows'
shift-click-action='minimize'
shift-middle-click-action='launch'
show-apps-at-top=true
show-dock-urgent-notify=false
show-trash=false

[just-perfection]
accent-color-icon=false
accessibility-menu=false
activities-button=false
animation=1
calendar=true
clock-menu=true
clock-menu-position=2
dash-separator=true
events-button=true
invert-calendar-column-items=false
keyboard-layout=false
max-displayed-search-results=0
notification-banner-position=1
panel=true
panel-in-overview=true
panel-notification-icon=true
power-icon=true
quick-settings-backlight=false
quick-settings-dark-mode=false
quick-settings-do-not-disturb=false
quick-settings-night-light=false
search=true
startup-status=0
support-notifier-showed-version=36
support-notifier-type=0
top-panel-position=0
weather=false
workspace=true
workspace-peek=true
workspaces-in-app-grid=true
world-clock=false

[lockscreen-extension]
background-image-path-1='file:///home/antareep/Antareep/Personal/photos/lock.png'
background-size-1='cover'
backgrounds-folder-path='/home/antareep/Antareep/Personal/photos'
blur-brightness-1=0.94000000000000028
blur-brightness-2=0.65000000000000002
blur-radius-1=3
blur-radius-2=0
gradient-direction-1='none'
hide-lockscreen-extension-button=true
local-share-backgrounds-folder-path=false
primary-color-1='red'
primary-color-2='red'
secondary-color-1='orange'
secondary-color-2='orange'
user-background-1=false
usr-local-share-backgrounds-folder-path=false
usr-share-backgrounds-folder-path=false

[windowgestures]
fn-fullscreen=false
fn-maximized-snap=false
fn-move=false
fn-move-snap=false
fn-resize=false
gesture-acceleration=23
swipe3-down=13
swipe3-downup=12
swipe4-right=19
swipe4-updown=3
taphold-move=false
three-finger=false
use-active-window=false
winswitch-position=1
